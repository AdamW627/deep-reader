#!/bin/bash
# paper — 在任意目录启动 / 打开 / 停止 DeepSeek Paper Reader。
set -euo pipefail

HOST=127.0.0.1
PORT=8765
BASE="http://$HOST:$PORT"
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PYTHON="$ROOT/.venv/bin/python"
PID_FILE="$ROOT/.data/server.pid"
LOG_FILE="$ROOT/.data/server.log"

healthy() { curl -fsS --max-time 2 "$BASE/api/health" >/dev/null 2>&1; }
alive() { [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; }

usage() {
  cat <<EOF
paper — DeepSeek Paper Reader 启动器

  paper            服务未运行时后台启动，然后在浏览器打开（默认命令）
  paper start      仅后台启动服务，不打开浏览器
  paper stop       停止后台服务
  paper restart    重启服务
  paper status     查看运行状态
  paper logs       查看并跟踪日志（Ctrl-C 退出）

服务地址：${BASE}（仅监听本机）
EOF
}

start() {
  if healthy; then echo "服务已在运行：$BASE"; return 0; fi
  if alive; then echo "后台进程存在但未响应，请查看日志：paper logs"; return 1; fi
  if [[ ! -x "$PYTHON" ]]; then echo "缺少虚拟环境：请先在 $ROOT 按 README 完成开发环境安装。"; return 1; fi
  mkdir -p "$ROOT/.data"
  : >>"$LOG_FILE"
  echo "正在启动服务…"
  (cd "$ROOT" && exec nohup "$PYTHON" -m uvicorn backend.app:app --host "$HOST" --port "$PORT" >>"$LOG_FILE" 2>&1) &
  echo $! >"$PID_FILE"
  for _ in $(seq 1 40); do
    if healthy; then echo "已启动：$BASE"; return 0; fi
    sleep 0.5
  done
  echo "启动超时，最近日志："
  tail -n 20 "$LOG_FILE"
  return 1
}

stop() {
  if alive; then
    local pid
    pid="$(cat "$PID_FILE")"
    echo "正在停止服务（PID ${pid}）…"
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.25
    done
    if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || true; fi
    echo "已停止。"
  else
    echo "没有由 paper 启动的后台服务。"
  fi
  rm -f "$PID_FILE"
}

status() {
  if healthy; then echo "运行中：$BASE"
  elif alive; then echo "进程存在但未响应（可能正在启动）：$BASE"
  else echo "未运行。"
  fi
}

cmd="${1:-open}"
case "$cmd" in
  start) start ;;
  open) start; if command -v open >/dev/null 2>&1; then open "$BASE"; elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$BASE"; else echo "请在浏览器打开 $BASE"; fi ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs) mkdir -p "$ROOT/.data"; : >>"$LOG_FILE"; echo "显示最近日志，Ctrl-C 退出跟踪。"; tail -n 40 -f "$LOG_FILE" ;;
  -h|--help|help) usage ;;
  *) usage; echo; echo "未知命令：$cmd"; exit 1 ;;
esac
